<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
            fx:controller="yourpackage.LoginController" prefWidth="600" prefHeight="400">

    <VBox spacing="20" alignment="CENTER" layoutX="100" layoutY="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

        <Label text="سیستم مدیریت کتابخانه" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <Button fx:id="memberButton" text="ورود عضو" onAction="#handleMemberLogin"
                style="-fx-font-size: 16px; -fx-padding: 10px 20px;" />

        <Button fx:id="librarianButton" text="ورود کتابدار" onAction="#handleLibrarianLogin"
                style="-fx-font-size: 16px; -fx-padding: 10px 20px;" />
    </VBox>

</AnchorPane>
